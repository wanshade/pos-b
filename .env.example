# =============================================================================
# POS App — environment variables (template — copy to .env and fill in)
# =============================================================================
# Generate a secret with:  openssl rand -base64 32

# Database — SQLite file under prisma/dev.db (dev) or your Postgres URL (prod)
DATABASE_URL="file:./dev.db"

# Better Auth — secret used to sign session cookies (REQUIRED, min 32 chars)
BETTER_AUTH_SECRET="change-me-with-openssl-rand-base64-32"

# Better Auth — base URL of the running app
# Dev (localhost):        http://localhost:3000
# Dev (Cloudflare tunnel): https://<your-tunnel>.trycloudflare.com
# Prod:                    https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# Trusted origin for cross-origin checks (same as BETTER_AUTH_URL in most cases)
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Public app name (shown in header / login page)
NEXT_PUBLIC_APP_NAME="POS App"